<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/text_config_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp" />

    <!-- Period Section -->
    <TextView
        android:id="@+id/text_period_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_period"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/radio_group_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_segment_bg"
        android:padding="3dp"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radio_7d"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:background="@drawable/widget_segment_item_selector"
            android:text="@string/widget_config_period_7d"
            android:textColor="@color/widget_segment_text_selector"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <RadioButton
            android:id="@+id/radio_30d"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:background="@drawable/widget_segment_item_selector"
            android:text="@string/widget_config_period_30d"
            android:textColor="@color/widget_segment_text_selector"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <RadioButton
            android:id="@+id/radio_month"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:background="@drawable/widget_segment_item_selector"
            android:text="@string/widget_config_period_month"
            android:textColor="@color/widget_segment_text_selector"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:checked="true" />
    </RadioGroup>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_hairline"
        android:layout_marginBottom="18dp" />

    <!-- Hide Balance Row -->
    <LinearLayout
        android:id="@+id/row_hide_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_hide_balance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_hide_balance_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/text_hide_balance_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_config_hide_balance_subtitle"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_hide_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_hairline"
        android:layout_marginBottom="16dp" />

    <!-- Wallet Section -->
    <TextView
        android:id="@+id/text_wallet_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_wallet"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdge="vertical"
        android:requiresFadingEdge="vertical">

        <RadioGroup
            android:id="@+id/radio_group_wallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_wallet_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:gravity="center_vertical"
                android:text="@string/widget_config_wallet_all"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:buttonTint="@color/widget_text_primary"
                android:paddingStart="12dp"
                android:checked="true" />

            <!-- Dynamic wallet entries added programmatically -->
        </RadioGroup>
    </ScrollView>

    <!-- Save Button -->
    <TextView
        android:id="@+id/btn_save_config"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/widget_btn_ripple"
        android:gravity="center"
        android:text="@string/widget_config_save"
        android:textColor="@color/widget_btn_icon"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
