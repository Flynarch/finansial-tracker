rules_version = '2';

// Deploy: firebase deploy --only storage
// Console: Storage → Rules — paste equivalent if you do not use CLI.

service firebase.storage {
  match /b/{bucket}/o {
    match /fintrack-backups/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
